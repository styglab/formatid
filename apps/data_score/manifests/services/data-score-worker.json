{
  "service_name": "data-score-worker",
  "service_type": "consumer",
  "dockerfile": "apps/data_score/adapters/worker/infra/image/Dockerfile",
  "build_context": "../..",
  "user": "${HOST_UID:-1000}:${HOST_GID:-1000}",
  "restart": "unless-stopped",
  "env_files": [
    "apps/data_score/adapters/worker/infra/env/app.env"
  ],
  "depends_on_service_healthy": [
    "postgres",
    "redis"
  ]
}
