{
  "app": "g2b_mcp",
  "description": "G2B MCP prototype",
  "profiles": [
    "g2b-mcp",
    "g2b"
  ],
  "nginx_routes": [
    {
      "path_prefix": "/g2b-mcp",
      "upstream_service": "g2b-mcp",
      "upstream_port": 8000,
      "strip_prefix": true,
      "proxy_buffering": false,
      "proxy_read_timeout": "3600s",
      "proxy_send_timeout": "3600s"
    }
  ],
  "requires": {}
}
