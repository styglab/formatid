{
  "service_name": "semantic-platform-worker",
  "service_type": "consumer",
  "dockerfile": "services/semantic_platform/adapters/worker/infra/image/Dockerfile",
  "build_context": "../..",
  "user": "${HOST_UID:-1000}:${HOST_GID:-1000}",
  "restart": "unless-stopped",
  "env_files": [
    "deploy/compose/env/prefect.env",
    "services/semantic_platform/adapters/admin_api/infra/env/app.env"
  ],
  "depends_on_service_healthy": [
    "prefect-server",
    "embedding-service",
    "qdrant"
  ]
}
