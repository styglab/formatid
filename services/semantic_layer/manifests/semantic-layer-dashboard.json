{
  "service_name": "semantic-layer-dashboard",
  "service_type": "api",
  "dockerfile": "services/semantic_layer/adapters/dashboard/infra/image/Dockerfile",
  "build_context": "../..",
  "restart": "unless-stopped",
  "ports": [
    "${HOST_BIND_IP:-127.0.0.1}:${SEMANTIC_LAYER_DASHBOARD_HOST_PORT:-8018}:3000"
  ],
  "depends_on_service_healthy": [
    "semantic-layer-api"
  ]
}
