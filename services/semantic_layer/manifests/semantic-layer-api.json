{
  "service_name": "semantic-layer-api",
  "service_type": "api",
  "dockerfile": "services/semantic_layer/adapters/admin_api/infra/image/Dockerfile",
  "build_context": "../..",
  "user": "${HOST_UID:-1000}:${HOST_GID:-1000}",
  "restart": "unless-stopped",
  "env_files": [
    "deploy/compose/env/postgres.env",
    "services/semantic_layer/adapters/admin_api/infra/env/app.env",
    "deploy/compose/env/minio.env"
  ],
  "ports": [
    "${HOST_BIND_IP:-127.0.0.1}:${SEMANTIC_LAYER_API_HOST_PORT:-8016}:8000"
  ],
  "depends_on_service_healthy": [
    "postgres",
    "embedding-service"
  ],
  "healthcheck": {
    "test": ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/health/ready', timeout=2).read()"],
    "interval": "10s",
    "timeout": "3s",
    "retries": 5
  }
}
