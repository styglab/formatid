{
  "service_name": "semantic-layer-worker",
  "service_type": "consumer",
  "dockerfile": "services/semantic_layer/adapters/worker/infra/image/Dockerfile",
  "build_context": "../..",
  "user": "${HOST_UID:-1000}:${HOST_GID:-1000}",
  "restart": "unless-stopped",
  "env_files": [
    "services/semantic_layer/adapters/admin_api/infra/env/app.env"
  ],
  "depends_on_service_healthy": [
    "prefect-server"
  ]
}
