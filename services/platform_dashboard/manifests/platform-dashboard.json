{
  "service_name": "platform-dashboard",
  "dockerfile": "services/platform_dashboard/infra/image/Dockerfile",
  "build_context": "../..",
  "restart": "unless-stopped",
  "ports": [
    "${HOST_BIND_IP:-127.0.0.1}:${DASHBOARD_HOST_PORT:-8080}:${DASHBOARD_CONTAINER_PORT:-80}"
  ],
  "depends_on_service_healthy": [
    "platform-api"
  ],
  "healthcheck": {
    "test": ["CMD", "wget", "-qO-", "http://127.0.0.1/"],
    "interval": "10s",
    "timeout": "3s",
    "retries": 5
  }
}
