{
  "service_name": "minio",
  "service_type": "object_storage",
  "image": "minio/minio:RELEASE.2025-04-22T22-12-26Z",
  "command": [
    "server",
    "/data",
    "--console-address",
    ":9001"
  ],
  "restart": "unless-stopped",
  "env_files": [
    "deploy/compose/env/minio.env"
  ],
  "ports": [
    "${HOST_BIND_IP:-127.0.0.1}:${MINIO_API_HOST_PORT:-9000}:9000",
    "${HOST_BIND_IP:-127.0.0.1}:${MINIO_CONSOLE_HOST_PORT:-9001}:9001"
  ],
  "volumes": [
    "${MINIO_DATA_DIR:-../../data/minio}:/data"
  ],
  "healthcheck": {
    "test": ["CMD", "curl", "-f", "http://localhost:9000/minio/health/live"],
    "interval": "10s",
    "timeout": "5s",
    "retries": 5
  }
}
